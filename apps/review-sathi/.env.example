# ---------------------------------------------------------------------------
# ReviewSathi environment. Copy to .env.local for local dev; add the same
# keys in Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# Public URL of the app, no trailing slash (used in emails and OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.in

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Show "Continue with Google" on the login page (enable the Google provider in Supabase Auth first)
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Encrypts Google tokens at rest. Never change it after launch, or stored tokens stop working.
TOKEN_ENCRYPTION_KEY=

# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate: openssl rand -hex 32
CRON_SECRET=

# Google Business Profile
# true = sample reviews, no Google calls. Keep true until Google approves your GBP API access.
GOOGLE_DEMO_MODE=true
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic (AI drafts). Without a key, simple template replies are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Razorpay → Account & Settings → API Keys (use test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → secret you choose when adding <APP_URL>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Razorpay → Subscriptions → Plans. Create two monthly plans and paste their ids (plan_...)
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=

# Resend (email). Without a key, emails are logged to the console instead.
RESEND_API_KEY=
EMAIL_FROM="ReviewSathi <alerts@yourdomain.in>"
