# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 to show login/dashboard/pricing and enable paid features
NEXT_PUBLIC_PAID_ENABLED=0

# ---------- Supabase (server-side service key must NEVER be exposed to the browser) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI providers ----------
# Each provider is a separate module. Disable one by setting ENABLE_<X>=0 (or leave its key empty).
OPENAI_API_KEY=
ENABLE_OPENAI=1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
ENABLE_GEMINI=1
GEMINI_MODEL=gemini-2.0-flash
PERPLEXITY_API_KEY=
ENABLE_PERPLEXITY=1
PERPLEXITY_MODEL=sonar
# Model used to parse answers into JSON (uses OPENAI_API_KEY; falls back to a heuristic parser)
PARSER_MODEL=gpt-4o-mini
# 1 = fake deterministic answers, no API calls, no keys needed (local testing)
AI_MOCK=0

# ---------- Cost and abuse controls ----------
MONTHLY_SPEND_CAP_USD=50
# Reserved against the cap before each free check runs (true cost is settled afterwards)
EST_COST_PER_CHECK_USD=0.15
FREE_CHECKS_PER_IP_PER_DAY=2
FREE_CHECKS_PER_EMAIL_PER_DAY=2
CACHE_TTL_HOURS=24
# Random string used to hash IPs/emails before storing them
HASH_SALT=change-me

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="AI Visibility Checker <reports@yourdomain.com>"

# ---------- Cron ----------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ---------- Razorpay (paid plans) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
